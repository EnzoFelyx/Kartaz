# Copie para .env.local e preencha.
GOOGLE_MAPS_API_KEY=

# Backend. Em dev, o app troca localhost pelo IP do Mac sozinho (funciona no iPhone físico)
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
# Só para desenvolvimento: vai embutido no app. Igual ao ADMIN_API_TOKEN do backend/.env
EXPO_PUBLIC_ADMIN_API_KEY=
# Opcional: origem das fotos dos jogadores quando o backend ainda não as hospeda (padrão: CDN da EA)
# EXPO_PUBLIC_PLAYER_IMAGE_BASE_URL=https://ratings-images-prod.pulse.ea.com/FC26/components/players
