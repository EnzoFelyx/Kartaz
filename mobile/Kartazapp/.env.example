# Copie para .env.local e preencha.
GOOGLE_MAPS_API_KEY=
# Opcional: Team ID da sua conta Apple, para assinar o build iOS.
APPLE_TEAM_ID=

# Backend. Em dev, o app troca localhost pelo IP do Mac sozinho (funciona no iPhone físico)
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
# Só para desenvolvimento: vai embutido no app. Igual ao ADMIN_API_TOKEN do backend/.env
EXPO_PUBLIC_ADMIN_API_KEY=
# Opcional: servidor de fotos dos jogadores (arquivos p<id>.webp) quando o backend ainda não as hospeda.
# Sem valor, as cartas mostram o fundo padrão. Use apenas imagens que você tenha direito de usar.
EXPO_PUBLIC_PLAYER_IMAGE_BASE_URL=
# Resoluções H3 (iguais a H3_RES_USER_CELL / H3_RES_ROOM_CELL do backend). Padrão: 9 e 8.
EXPO_PUBLIC_H3_RES_USER_CELL=9
EXPO_PUBLIC_H3_RES_ROOM_CELL=8
# Opcional, para gravações: ponto de partida fixo "lat,lng" no lugar do GPS (não expõe a sua posição real).
# Ex.: Méqui 1000, Av. Paulista: -23.5604471,-46.6580894
EXPO_PUBLIC_DEMO_LOCATION=
